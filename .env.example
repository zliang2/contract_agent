# Copy to .env (gitignored). Never commit real keys.
DATABASE_URL=postgresql://clausewitz:clausewitz@localhost:5432/clausewitz
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional: use Gemini through Google AI Studio instead of Vertex AI.
GEMINI_API_KEY=
# Model IDs (examples: claude-opus-5-5, claude-haiku-5-5, gemini-*). Never hard-coded in code.
GENERATE_MODEL=
VERIFY_MODEL=
# Eval only: independent grounding judge; should differ from VERIFY_MODEL.
JUDGE_MODEL=
BM25_INDEX_PATH=indexes/bm25
# Production only: gs://bucket/prefix to download the BM25 index from at startup.
BM25_INDEX_URI=
PRICE_TABLE_PATH=evals/prices.json
CUAD_PATH=data/raw/CUAD_v1/CUAD_v1.json
